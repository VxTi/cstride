import System::{
    io::print
};

type Array<T> = {
    elements: T[];
    count: i32;
    at: (i32) -> T;
};

fn arrayOf<T>(elements: T[], count: i32): Array<T> {
    return Array<T>::{
        elements,
        count,
        at: (index: i32): T -> elements[index]
    };
}

type Callback = () -> void;

fn makeCb(): Callback {
    const names = arrayOf<string>(["Toyota", "Honda", "Ford", "Toyota"], 4);

    return (): void -> io::print("\x1b[32mDriving the car: %s", names.at(1));
}

fn main(): i32 {
    makeCb()();

    return 0;
}